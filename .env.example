TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=data/telegram
CHANNELS=proxy_mania,MTProtoProxies
SCAN_INTERVAL_SECONDS=300
CHECK_TIMEOUT_SECONDS=8
FAILURES_BEFORE_REMOVE=3
MAX_MESSAGES_PER_CHANNEL=100
OPEN_TELEGRAM_AUTOMATICALLY=false

# Stable self-hosted cluster mode. The same secret is deployed to every node.
STABLE_PROXY_HOST=
STABLE_PROXY_PORT=443
STABLE_PROXY_SECRET=
CLUSTER_NODES=eu=203.0.113.10,us=203.0.113.20
NODE_FAILURES_BEFORE_DNS_REMOVAL=2

# Optional automatic DNS failover through Cloudflare DNS (records must be DNS-only).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
